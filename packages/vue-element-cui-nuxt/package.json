{
	"name": "@eams-monorepo/vue-element-cui-nuxt",
	"description": "EAMS Vue Element CUI Nuxt Documentation Site",
	"homepage": "https://vec.ruan-cat.com",
	"version": "4.0.0",
	"type": "module",
	"scripts": {
		"dev": "nuxt dev",
		"predev": "nuxt prepare",
		"prebuild": "nuxt prepare",
		"build": "pnpm run build:vercel",
		"build:docs": "pnpm run build:vercel",
		"build:vercel": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nuxt build --preset vercel",
		"build:node": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nuxt build --preset node-server",
		"turbo:build:vercel": "turbo run move-vercel-output-to-root --filter=@eams-monorepo/vue-element-cui-nuxt",
		"move-vercel-output-to-root": "move-vercel-output-to-root",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"postinstall": "nuxt prepare"
	},
	"dependencies": {
		"@eams-monorepo/vue-element-cui": "workspace:*",
		"@popperjs/core": "^2.11.8",
		"@vueuse/core": "^14.3.0",
		"@ztl-uwu/nuxt-content": "^2.14.1",
		"element-plus": "^2.14.8",
		"entities": "^7.0.1",
		"h3": "^1.15.11",
		"nuxt": "^4.6.4",
		"shadcn-docs-nuxt": "^1.2.2",
		"tailwindcss": "^4.3.0",
		"tailwindcss-animate": "^1.0.7",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.149",
		"@ruan-cat/utils": "^4.25.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/test-utils": "^2.4.6",
		"cross-env": "^10.1.0",
		"jsdom": "^25.0.1",
		"rolldown": "~1.2.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.0"
	},
	"author": {
		"name": "ruan-cat",
		"email": "1219043956@qq.com",
		"url": "https://github.com/ruan-cat"
	}
}
